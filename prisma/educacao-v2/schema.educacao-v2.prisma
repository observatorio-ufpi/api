// Schema educacional v2 — Postgres namespace `educacao_v2`.
//
// Recorte: localidade, consolidados da educação básica e fatias de matrícula.
// Fatias comentadas no final do bloco de matrícula: descomente + migrate.
// O v1 (`prisma/educacao/schema.educacao.prisma`) permanece intacto.

generator educacaoV2Client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/educacao-v2-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_EDUCACAO")
  schemas  = ["educacao_v2"]
}

/// Dataset: dados_educacionais_basicos/_municipios_piaui.json
model Localidade {
  id                         Int      @id
  nome                       String
  tipo                       String
  uf                         String?  @db.Char(2)
  codigo_ibge                String?  @unique
  territorio_desenvolvimento String?
  aglomerado                 String?
  gerencia_regional          String?
  populacao_2022             Int?
  faixa_populacional         String?
  latitude                   Decimal? @db.Decimal(18, 12)
  longitude                  Decimal? @db.Decimal(18, 12)

  basica_matricula                 BasicaMatricula[]
  basica_matricula_por_etapa       BasicaMatriculaPorEtapa[]
  basica_matricula_por_dependencia BasicaMatriculaPorDependencia[]
  basica_matricula_por_localizacao BasicaMatriculaPorLocalizacao[]
  basica_matricula_por_sexo        BasicaMatriculaPorSexo[]
  basica_matricula_por_cor_raca    BasicaMatriculaPorCorRaca[]
  basica_matricula_por_faixa_etaria        BasicaMatriculaPorFaixaEtaria[]
  // basica_matricula_por_tempo_integral      BasicaMatriculaPorTempoIntegral[]
  // basica_matricula_por_turno               BasicaMatriculaPorTurno[]
  // basica_matricula_por_localizacao_diff    BasicaMatriculaPorLocalizacaoDiff[]
  // basica_matricula_por_classe_especial     BasicaMatriculaPorClasseEspecial[]
  // basica_matricula_por_educacao_especial   BasicaMatriculaPorEducacaoEspecial[]
  // basica_matricula_por_pee                 BasicaMatriculaPorPee[]
  // basica_matricula_por_pee_categoria       BasicaMatriculaPorPeeCategoria[]
  // basica_matricula_por_modalidade_integral BasicaMatriculaPorModalidadeIntegral[]
  basica_turma                     BasicaTurma[]
  basica_escola                    BasicaEscola[]
  basica_funcionario               BasicaFuncionario[]
  basica_docente                   BasicaDocente[]

  @@map("localidade")
  @@schema("educacao_v2")
}

/// Dataset (soma Urbana+Rural): matriculas/{classico|moderno}/{ano}/location
model BasicaMatricula {
  id            Int        @id @default(autoincrement())
  localidade_id Int
  ano           Int
  total         Decimal    @db.Decimal(15, 2)
  localidade    Localidade @relation(fields: [localidade_id], references: [id])

  @@unique([localidade_id, ano], map: "bmat_uk")
  @@index([localidade_id, ano])
  @@index([ano])
  @@map("basica_matricula")
  @@schema("educacao_v2")
}

/// Dataset: matriculas/classico/{ano}/education_level_mod
